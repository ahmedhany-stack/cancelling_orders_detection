# ==========================================
# Python & Editors Cache
# ==========================================
__pycache__/
*.py[cod]
*$py.class
.vscode/
.idea/
.ipynb_checkpoints/
.cache/
.pytest_cache/

# ==========================================
# Virtual Environment
# ==========================================
venv/
.venv/
env/
ENV/

# ==========================================
# Environment Variables & Logs
# ==========================================
.env
logs/
*.log
mlruns/
mlflow.db

# ==========================================
# Build Management
# ==========================================
*.egg-info/
src.egg-info/
build/
dist/

# ==========================================
# Data & Data Artifacts (Ignored by Git, Tracked by DVC)
# ==========================================
data/
*.csv
*.xlsx

# تجاهل ملفات البيانات الكبيرة داخل artifacts مع السماح بـ .dvc
artifacts/features/*.csv
artifacts/raw_data.csv
artifacts/clean_data.csv

# الاستثناءات المطلوبة (رفع الموديلات والـ dvc والـ metrics)
!*.dvc
!.gitignore
!artifacts/
!artifacts/models/
!artifacts/preprocessors/
!artifacts/models/metrics.json
!saved_models/
!saved_preprocessors/
!*.pkl
!*.joblib